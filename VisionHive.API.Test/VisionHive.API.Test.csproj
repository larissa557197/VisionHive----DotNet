<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <!-- Framework de testes (mesmo padrão do professor) -->
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>

        <!-- Testes de integração -->
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.8" />

        <!-- Moq e FluentAssertions (mesmo usados no exemplo do professor) -->
        <PackageReference Include="Moq" Version="4.20.69" />
        <PackageReference Include="FluentAssertions" Version="6.12.0" />

        <!-- Cobertura de testes -->
        <PackageReference Include="coverlet.collector" Version="6.0.0" />
    </ItemGroup>

    <ItemGroup>
        <!-- Referências para os projetos da solução -->
        <ProjectReference Include="..\VisionHive.Application\VisionHive.Application.csproj" />
        <ProjectReference Include="..\VisionHive.Domain\VisionHive.Domain.csproj" />
        <ProjectReference Include="..\VisionHive.Infrastructure\VisionHive.Infrastructure.csproj" />
        <ProjectReference Include="..\VisionHive.API\VisionHive.API.csproj" />
    </ItemGroup>

</Project>
